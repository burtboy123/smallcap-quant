# Copy this file to .env and fill in your values. NEVER commit .env — it is gitignored.
# Fundamentals come from yfinance (live) and SEC XBRL (research); neither needs a key.

# Database (use sqlite:///quant_system.db for development)
DATABASE_URL=sqlite:///quant_system.db

# Optional: PostgreSQL for production (also: pip install psycopg2-binary)
# DATABASE_URL=postgresql://user:password@localhost:5432/quant_system


# ─────────────────────────────────────────────────────────────────────────────
# MONITORING ALERTS  (monitoring/health_check.py)
# ─────────────────────────────────────────────────────────────────────────────
# All optional. With email disabled, alerts still go to
# monitoring/state/alert_log.jsonl and the dashboard — email is an upgrade, not a
# prerequisite, so monitoring is never silently switched off by a missing setting.
#
# GMAIL: ALERT_SMTP_PASSWORD must be a 16-character App Password, NOT your account
# password — Google rejects plain passwords for SMTP. Generate one at
#   Google Account -> Security -> 2-Step Verification -> App passwords
# 2-Step Verification must be on for App passwords to be offered. Paste the 16
# characters with no spaces. Treat it as a password: it grants send-as-you access.
#
# OUTLOOK / OFFICE 365:  ALERT_SMTP_HOST=smtp.office365.com  ALERT_SMTP_PORT=587
# Port 587 uses STARTTLS; port 465 uses implicit SSL. Both are handled.

ALERT_EMAIL_ENABLED=false
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=you@gmail.com
ALERT_SMTP_PASSWORD=your_16_char_app_password
ALERT_EMAIL_FROM=you@gmail.com
# Comma-separated for several recipients.
ALERT_EMAIL_TO=you@gmail.com

# ─────────────────────────────────────────────────────────────────────────────
# BACKUPS  (scripts/backup.py, run weekly by the Monday health task)
# ─────────────────────────────────────────────────────────────────────────────
# Where the weekly zip goes. Use a folder that syncs off this machine, e.g.
#   BACKUP_DIR=C:\Users\you\OneDrive\quant_backups
# Default: <repo>/backups (gitignored -- still on THIS disk). .env itself is never
# included in the backup.
BACKUP_DIR=

# ─────────────────────────────────────────────────────────────────────────────
# SEC EDGAR  (data/sec_xbrl.py -- research fundamentals, optional)
# ─────────────────────────────────────────────────────────────────────────────
# SEC requires a real contact in the User-Agent of every request, or it blocks you.
# Format: your name, a space, your email.
SEC_USER_AGENT=Your Name your.email@example.com
